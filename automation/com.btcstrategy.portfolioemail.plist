<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.btcstrategy.portfolioemail</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python3</string>
        <string>/Users/gaozhiyuan/Desktop/btc_daily_strategy/portfolio_email.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gaozhiyuan/Desktop/btc_daily_strategy</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/gaozhiyuan/Desktop/btc_daily_strategy</string>
    </dict>

    <!-- Run daily at 09:00 local time. Change Hour/Minute to taste. -->
    <key>StartCalendarInterval</key>
