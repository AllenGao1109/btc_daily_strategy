        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gaozhiyuan/Desktop/btc_daily_strategy/logs/daily_email.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gaozhiyuan/Desktop/btc_daily_strategy/logs/daily_email.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
